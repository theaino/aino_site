package views

templ Base() {
  <!doctype html>
  <html>
    <head>
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <link rel="icon" type="image/x-icon" href="/res/favicon.ico">
      <title>Aino's site</title>
      @style()
    </head>
    <body>
      { children... }
    </body>
  </html>
}

templ style() {
  <style>
    @viewport {
      width: devicewidth;
      zoom: 1.0;
    }
    body {
      background-color: black;
      color: white;
    }
    a:visited {
      color:blue;
    }
  </style>
}
